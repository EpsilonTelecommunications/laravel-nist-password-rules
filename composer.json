{
    "name": "langleyfoxall/laravel-nist-password-rules",
    "description": "🔒 Provides Laravel validation rules that follow the password related recommendations found in NIST Special Publication 800-63B.",
    "type": "library",
    "license": "LGPL-3.0-only",
    "authors": [
        {
            "name": "Jordan Hall",
            "email": "jordan@langleyfoxall.co.uk"
        }
    ],
    "repositories": [
        {
            "url": "git@github.com:EpsilonTelecommunications/laravel-password-exposed-validation-rule.git",
            "type": "vcs"
        },
        {
            "url": "git@github.com:langleyfoxall/password_exposed.git",
            "type": "vcs"
        },
        {
            "url": "git@github.com:langleyfoxall/psr-18-guzzle-adapter.git",
            "type": "vcs"
        },
        {
            "url": "git@github.com:langleyfoxall/DO-File-Cache-PSR-6.git",
            "type": "vcs"
        }
    ],
    "require": {
        "php": ">=7.2",
        "laravel/framework": "^5.5||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0||^12.0",
        "divineomega/laravel-password-exposed-validation-rule": "dev-laravel-12.x"
    },
    "require-dev": {
        "fakerphp/faker": "^1.14.1|^1.9.1",
        "php-coveralls/php-coveralls": "^2.0",
        "orchestra/testbench": "^5.17.1|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "LangleyFoxall\\LaravelNISTPasswordRules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LangleyFoxall\\LaravelNISTPasswordRules\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LangleyFoxall\\LaravelNISTPasswordRules\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
